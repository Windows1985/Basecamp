# Installation (handled automatically by pi_setup.sh):
#   sudo cp /home/pi/basecamp/systemd/basecamp-backup.service /etc/systemd/system/
#   sudo cp /home/pi/basecamp/systemd/basecamp-backup.timer  /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable basecamp-backup.timer
#   sudo systemctl start basecamp-backup.timer
#
# Do NOT enable basecamp-backup.service directly — it runs via the timer only.

[Unit]
Description=Basecamp nightly SQLite backup
After=network.target
OnFailure=basecamp-notify@%n.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/basecamp
ExecStart=/usr/bin/python3 /home/pi/basecamp/server/backup.py
StandardOutput=journal
StandardError=journal
