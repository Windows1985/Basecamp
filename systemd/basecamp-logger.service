# Installation:
#   sudo cp /home/pi/basecamp/systemd/basecamp-logger.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable basecamp-logger
#   sudo systemctl start basecamp-logger

[Unit]
Description=Basecamp Sensor Logger
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/basecamp
ExecStart=/usr/bin/python3 /home/pi/basecamp/server/logger.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
